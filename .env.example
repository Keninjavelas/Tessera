# ==============================================================================
# Tessera — Environment Configuration Template
# Copy this file to `.env` and fill in your credentials. Never commit `.env`.
# ==============================================================================

# --- Phase III: Multi-Tier LLM Extraction Providers ---
# Tier 1: Google Gemini Flash (Primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tier 2: Groq (First Fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Tier 3: DeepSeek (Secondary Fallback)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Phase I: GitHub API Token (Optional, raises rate limit 60 -> 5,000 req/hr) ---
GITHUB_TOKEN=

# --- Optional: Google Sheets Export ---
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Pipeline Runtime & Concurrency Settings ---
TESSERA_DATA_DIR=data
TESSERA_EXPORT_DIR=exports
TESSERA_DB_PATH=data/tessera_state.db
TESSERA_LOG_LEVEL=INFO
TESSERA_HTTP_MAX_CONCURRENCY=20
TESSERA_PER_DOMAIN_CONCURRENCY=4
TESSERA_HTTP_TIMEOUT_SECONDS=25.0
TESSERA_LLM_MAX_INPUT_TOKENS=6000
TESSERA_LLM_MAX_RETRIES=3
TESSERA_FRESHNESS_HOURS=24
